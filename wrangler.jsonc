{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clusterflick-api-alerts",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // The listings come from clusterflick.com over the public internet, as
  // api-mcp reads them, never same-zone routing.
  "compatibility_flags": ["global_fetch_strictly_public"],
  // Its own host, the one the emails come from: the preview the site asks for,
  // and (once sending) the unsubscribe links. Cloudflare makes the DNS record
  // and certificate on deploy; the sending records live on cf-bounce and
  // _dmarc beneath it, and don't clash.
  "routes": [{ "pattern": "alerts.clusterflick.com", "custom_domain": true }],
  "workers_dev": false,
  "vars": {
    // Where the listings are read from (`data/current.json`), what the emails
    // link to, and the only origin whose pages may ask for a preview.
    "SITE_ORIGIN": "https://clusterflick.com",
    // Public: it's in the site's Firebase web config too.
    "FIREBASE_PROJECT_ID": "clusterflick-com",
    // "true" works out each reader's email and records it as one that would
    // have gone, and sends nothing: for trying a change out. Anything but
    // "false" sends nothing.
    "DRY_RUN": "false",
    // Where replies to an alert go: an address that's read, on the root
    // domain's own mail (Fastmail), not alerts.clusterflick.com, which
    // receives nothing.
    "REPLY_TO": "hello@clusterflick.com",
    // This Worker, as the emails' unsubscribe links reach it.
    "ALERTS_ORIGIN": "https://alerts.clusterflick.com",
  },
  // Cloudflare Email Service, sending from alerts.clusterflick.com (onboarded
  // in the dashboard), and only ever from the one address.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["alert@alerts.clusterflick.com"],
    },
  ],
  // This Worker's own service account, with Cloud Datastore User: it reads a
  // reader's settings, capabilities and watchlist, and writes their ledger.
  // Set with `wrangler secret put`, locally in `.dev.vars`.
  // And UNSUBSCRIBE_SECRET, which signs each email's unsubscribe link: any
  // long random string, never shown anywhere.
  "secrets": { "required": ["FIREBASE_SERVICE_ACCOUNT", "UNSUBSCRIBE_SECRET"] },
  // Per-location and approximate, as in the other Workers. api-tmdb-search
  // has 1xxx, api-profiles 2xxx, api-mcp 3xxx. One limit for what the site's
  // pages ask (a preview, remembering the watchlist): each reads the listings
  // and the reader's documents, so a few a minute is plenty.
  "ratelimits": [
    {
      "name": "READER_LIMIT",
      "namespace_id": "4001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  // What Email Service says happened to what was sent: an event subscription
  // on alerts.clusterflick.com's sending (bounced, complained, rejected,
  // failed), set up in the dashboard, publishes to this queue.
  "queues": {
    "consumers": [
      { "queue": "alert-events", "max_batch_size": 10, "max_retries": 5 },
    ],
  },
  // 20:00 UTC: 8pm in winter, 9pm under BST, for now.
  "triggers": { "crons": ["0 20 * * *"] },
  // api-tmdb-search has 8787, api-profiles 8788, api-mcp 8789.
  "dev": { "port": 8790, "host": "localhost:8790" },
  // Workers Paid has no spend cap, so a ceiling per invocation. Reading the
  // listings is most of it (~120ms in Node for api-mcp); a night's run then
  // compares each reader's watchlist. Headroom, not a fit: lower it once
  // Workers Logs show what a run costs.
  "limits": { "cpu_ms": 1000 },
  "observability": { "enabled": true },
}
